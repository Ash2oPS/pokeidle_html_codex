{
  "name": "pokeidle-html-codex",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @pokeidle/game --filter @pokeidle/tools dev",
    "dev:game": "corepack pnpm --filter @pokeidle/game dev",
    "dev:tools": "corepack pnpm --filter @pokeidle/tools dev",
    "generate:pokemon": "node scripts/import-pokemon-data.mjs",
    "check:docs": "node scripts/validate-docs.mjs",
    "test": "corepack pnpm -r --if-present test",
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "check": "npm run check:docs && corepack pnpm typecheck && corepack pnpm test"
  }
}