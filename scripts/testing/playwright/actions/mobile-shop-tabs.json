{
  "steps": [
    {
      "waitForState": {
        "mode": "ready",
        "starter_modal_visible": true
      },
      "waitStateTimeoutMs": 15000
    },
    {
      "clickSelector": "#starter-modal:not(.hidden) .starter-choice",
      "waitMs": 500
    },
    {
      "waitForState": {
        "save_team_size": {
          "min": 1
        },
        "starter_modal_visible": false
      },
      "waitStateTimeoutMs": 12000
    },
    {
      "clickSelectorIfVisible": "#tutorial-close-btn",
      "waitMs": 900
    },
    {
      "clickSelector": "#action-dock-pokeball-toggle"
    },
    {
      "waitForSelector": "#action-dock-fullscreen-menu:not(.hidden)",
      "waitMs": 700
    },
    {
      "clickSelector": "#action-dock-fullscreen-menu [data-action-target='shop-btn']"
    },
    {
      "waitForSelector": "#shop-modal:not(.hidden)",
      "waitMs": 900
    },
    {
      "captureName": "shop-pokeballs"
    },
    {
      "clickSelector": "#shop-tab-combat",
      "waitMs": 500
    },
    {
      "captureName": "shop-combat"
    },
    {
      "clickSelector": "#shop-tab-evolutions",
      "waitMs": 500
    },
    {
      "captureName": "shop-evolutions"
    }
  ]
}
