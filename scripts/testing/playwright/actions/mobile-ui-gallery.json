    {
      "waitForSelector": "#route-nav-info-panel:not(.hidden)",
      "waitMs": 500
    },
    {
      "captureName": "route-nav-lock-info"
    },
    {
      "clickSelectorIfVisible": "#route-nav-info-panel [data-route-info-close='true']",
      "waitMs": 300
