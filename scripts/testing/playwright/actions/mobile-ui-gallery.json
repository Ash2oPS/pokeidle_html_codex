    {
      "clickSelectorIfVisible": "#tutorial-close-btn",
      "waitMs": 900
    },
    {
      "captureName": "idle"
    },
    {
      "clickSelector": "#route-nav-drawer-toggle"
    },
    {
      "waitForSelector": "#route-nav-drawer:not(.hidden)",
      "waitMs": 500
    },
    {
      "captureName": "route-nav-drawer"
    },
    {
      "waitForSelector": "#route-nav-drawer-list [data-route-action='info']",
      "waitMs": 350
    },
    {
      "clickSelector": "#route-nav-drawer-list [data-route-action='info']"
